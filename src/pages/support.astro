---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DISCORD_INVITE_URL, SUPPORT_EMAIL, GITHUB_ISSUES_URL } from '../config/support.mjs';
const base = import.meta.env.BASE_URL;
const requestTemplate = `CE-Deploy version:
Operating system and version:
Affected feature:
Environment (cloud or on-premises):
What I expected:
What actually happened (include any error message):
Steps to reproduce:
What I have already tried:
Sanitized screenshots or logs:`;
---
<BaseLayout title="Support — CE-Deploy" description="Get best-effort CE-Deploy support through the Discord support forum, email, or GitHub Issues.">
  <div class="page-hero"><div class="container"><div class="eyebrow">CE-Deploy support</div><h1>Get help. Share what you learn.</h1><p>Support has moved to our Discord server. Bring your questions to the support forum and learn from other CE-Deploy users.</p><div class="actions"><a class="button" href={DISCORD_INVITE_URL}>Join Discord</a><a class="button secondary" href={`${base}documentation/`}>Browse documentation</a></div><p class="expectations">Support is best effort. There is no guaranteed response time, including for paid memberships.</p></div></div>
  <section><div class="container"><div class="section-heading"><h2>Start in the support forum.</h2><p>A Discord account is required to participate.</p></div><ol class="steps"><li><strong>Join the CE-Deploy server.</strong> Use the Join Discord button and follow the server’s welcome instructions.</li><li><strong>Open the support forum.</strong> Look for an existing post that matches your question.</li><li><strong>Create a post if you need help.</strong> Give it a descriptive title and include the details below. Keep follow-up information in the same post.</li></ol></div></section>
  <section class="band"><div class="container"><div class="section-heading"><h2>Help us understand the problem.</h2><p>Copy this template into your Discord post, email, or GitHub issue and fill in what you know.</p></div><pre tabindex="0" aria-label="Support request template">{requestTemplate}</pre><div class="actions"><button class="button" id="copy-template" type="button">Copy request template</button></div><p id="copy-status" role="status" aria-live="polite"></p><p class="privacy"><strong>Before sharing:</strong> remove tokens, passwords, keys, customer information, and identifying device details from screenshots and logs. For account, billing, or sensitive questions, use email first and describe the problem without sending credentials.</p></div></section>
  <section><div class="container"><div class="section-heading"><h2>Other ways to reach us.</h2><p>Can’t use Discord at work, or prefer another route? Email and GitHub Issues are still available. The same best-effort support policy applies.</p></div><div class="grid-2"><article class="card"><h3>Email</h3><p>Use email if Discord is unavailable, or for account, membership, billing, or sensitive questions.</p><a class="contact-link" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></article><article class="card"><h3>GitHub Issues</h3><p>You can still report bugs or request features on GitHub if you prefer. Check existing issues before opening a new one.</p><a class="button secondary" href={GITHUB_ISSUES_URL}>Open GitHub Issues</a></article></div></div></section>
</BaseLayout>
<style>
  .expectations{font-size:1rem!important;margin-top:24px}.steps{max-width:760px;padding-left:24px;color:var(--muted)}.steps li{padding:10px 0 10px 8px}.steps strong,.privacy strong{color:var(--text)}pre{max-width:850px;white-space:pre-wrap;overflow-wrap:anywhere;padding:24px;border:1px solid var(--line);border-radius:16px;background:var(--surface);color:var(--text);font-size:.95rem;line-height:1.8}.privacy{max-width:850px;color:var(--muted)}.contact-link{color:var(--cyan);text-decoration:underline;overflow-wrap:anywhere}.button{font:inherit;font-weight:760;border:0;cursor:pointer}a:focus-visible,button:focus-visible,pre:focus-visible{outline:2px solid var(--cyan);outline-offset:4px}
</style>
<script>
  document.querySelector('#copy-template')?.addEventListener('click', async () => {
    const template = document.querySelector('pre')?.textContent;
    const status = document.querySelector('#copy-status');
    if (!template || !status) return;
    try { await navigator.clipboard.writeText(template); status.textContent = 'Template copied. Paste it into your support request.'; }
    catch { status.textContent = 'Select and copy the template above to include it in your support request.'; }
  });
</script>
