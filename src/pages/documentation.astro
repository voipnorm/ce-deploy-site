---
import BaseLayout from '../layouts/BaseLayout.astro';
const docs=['Getting started','Connect a cloud organization','Add on-premises devices','Run your first deployment','Build reusable templates','Audit configuration drift','Schedule and automate work','Troubleshooting'];
---
<BaseLayout title="Documentation — CE-Deploy" description="Quick-start documentation and operational guides for CE-Deploy."><div class="page-hero"><div class="container"><div class="eyebrow">Documentation</div><h1>Start simple. Scale when you’re ready.</h1><p>The initial documentation hub provides the path into CE-Deploy. Detailed guides will be added here as the site grows.</p></div></div><section><div class="container grid-2"><article class="card"><h2>Quick start</h2><ol><li>Download the latest release for macOS or Windows.</li><li>Add a cloud organization or on-premises environment.</li><li>Discover devices and select a target.</li><li>Choose a deployment type, validate and run.</li></ol><a class="button" href="https://github.com/voipnorm/CE-Deploy/releases/latest">Get the latest release</a></article><article class="card doc-list"><h2>Guide library</h2>{docs.map(doc=><a href="https://github.com/voipnorm/CE-Deploy#readme">{doc}<span>→</span></a>)}</article></div></section></BaseLayout>
