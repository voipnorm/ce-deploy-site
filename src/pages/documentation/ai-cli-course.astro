.compartments .flow>b{display:none}</style><script>
// Revision 2 reorders lessons; use a separate key so old numbers cannot mark different topics complete.
const key='ce-deploy-ai-course-v2';
let completed: number[]=[];
try {const saved=JSON.parse(localStorage.getItem(key)||'[]');if(Array.isArray(saved))completed=[...new Set(saved.filter((n)=>Number.isInteger(n)&&n>=1&&n<=6))];} catch {}
function render(){document.querySelectorAll<HTMLButtonElement>('[data-ai-lesson]').forEach(b=>{const id=Number(b.dataset.aiLesson);const done=completed.includes(id);b.classList.toggle('done',done);b.setAttribute('aria-pressed',String(done));b.textContent=done?`Lesson ${id} complete ✓`:`Mark lesson ${id} complete`;});const count=document.getElementById('aiProgress');if(count)count.textContent=`${completed.length} of 6`;try{localStorage.setItem(key,JSON.stringify(completed));}catch{}}
document.querySelectorAll<HTMLButtonElement>('[data-ai-lesson]').forEach(b=>b.addEventListener('click',()=>{const id=Number(b.dataset.aiLesson);completed=completed.includes(id)?completed.filter(n=>n!==id):[...completed,id];render();}));
document.getElementById('aiReset')?.addEventListener('click',()=>{completed=[];render();});
document.querySelectorAll<HTMLButtonElement>('.copy-prompt').forEach(b=>b.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(b.parentElement?.querySelector('p')?.textContent||'');b.textContent='Copied';}catch{b.textContent='Select and copy the prompt above';}}));render();
</script>