---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const features = [
  ['Cloud and on-premises inventory, organization management, and targeting', true],
  ['Bulk configurations, macros, branding, UI extensions, certificates, and phonebooks', true],
  ['Macro Factory, Macro Drift, and xAPI Forge', true],
  ['Config Auditor, compliance reports, and CSV workflows', true],
  ['PhonePilot, Environmental Intelligence, and troubleshooting tools', true],
  ['Existing scheduler, recurring jobs, templates, and multi-step template chains', true],
  ['New Automation feature', false],
];
---
<BaseLayout title="Membership — CE-Deploy" description="Compare CE-Deploy Free, Pro at $50 per month, and Partner Plus at $100 per month. Existing features stay free. Explore paid memberships on Buy Me a Coffee.">
  <div class="page-hero membership-hero">
    <div class="container">
      <div class="eyebrow">Membership</div>
      <h1>Your tools today.<br />More ways to grow.</h1>
      <p>All existing CE-Deploy 16.3.7 functionality stays in Free. Pro adds the new Automation feature, and Partner Plus adds delegated customer management.</p>
    </div>
  </div>

  <section class="plans-section" aria-label="Membership plans">
    <div class="container">
      <div class="grid-3 plans">
        <article class="card plan">
          <span class="plan-status available">Available now</span>
          <h2>Free</h2>
          <p class="plan-summary">The existing CE-Deploy toolkit for managing your fleet.</p>
          <p class="price"><strong>$0</strong><span>/ month</span></p>
          <ul class="feature-list">
            <li>All existing 16.3.7 functionality</li>
            <li>Cloud and on-premises operations</li>
            <li>Deployment, macro tools, and Config Auditor</li>
            <li>PhonePilot and Environmental Intelligence</li>
            <li>Existing scheduling and template workflows</li>
          </ul>
          <div class="plan-action"><a class="button secondary" href={`${base}downloads/`}>Download Free</a></div>
        </article>
        <article class="card plan pro-plan">
          <h2>Pro</h2>
          <p class="plan-summary">For operators ready to add the new Automation feature.</p>
          <p class="price"><strong>$50</strong><span>/ month</span></p>
          <ul class="feature-list">
            <li>Everything in Free</li>
            <li>New Automation feature</li>
            <li>Two computer activations</li>
            <li>30-day Pro trial</li>
          </ul>
          <div class="plan-action"><a class="button" href="https://buymeacoffee.com/voipnorm/membership" aria-label="Explore Pro membership on Buy Me a Coffee">View membership on BMC</a></div>
        </article>
        <article class="card plan">
          <h2>Partner Plus</h2>
          <p class="plan-summary">For partners managing multiple customer organizations.</p>
          <p class="price"><strong>$100</strong><span>/ month</span></p>
          <ul class="feature-list">
            <li>Everything in Free and Pro</li>
            <li>Delegated customer organization management</li>
            <li>Four computer activations</li>
            <li>Up to 30 selected customer organizations per computer, plus 30 ordinary connections</li>
            <li>Separate 30-day Partner Plus trial</li>
          </ul>
          <div class="plan-action"><a class="button" href="https://buymeacoffee.com/voipnorm/membership" aria-label="Explore Partner Plus membership on Buy Me a Coffee">View membership on BMC</a></div>
        </article>
      </div>
      <p class="plans-note">Paid-tier pricing is monthly. Explore Pro and Partner Plus memberships on Buy Me a Coffee.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="comparison-heading">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">Compare plans</div>
        <h2 id="comparison-heading">What’s included.</h2>
        <p>Your existing tools remain free. Pro adds Automation, and Partner Plus adds delegated customer management.</p>
      </div>
      <div class="comparison-scroll" role="region" aria-label="Membership feature comparison" tabindex="0">
        <table>
          <caption>Compare Free, Pro, and Partner Plus memberships.</caption>
          <thead><tr><th scope="col">Capability</th><th scope="col">Free</th><th scope="col">Pro</th><th scope="col">Partner Plus</th></tr></thead>
          <tbody>
            {features.map(([label, free]) => <tr><th scope="row">{label}</th><td>{free ? 'Included' : 'Not included'}</td><td>Included</td><td>Included</td></tr>)}
            <tr><th scope="row">Delegated customer management</th><td>Not included</td><td>Not included</td><td>Included</td></tr>
            <tr><th scope="row">Paid membership computer activations</th><td>Not applicable</td><td>2</td><td>4</td></tr>
            <tr><th scope="row">Paid-tier trial</th><td>Not needed</td><td>30 days</td><td>30 days</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section aria-labelledby="questions-heading">
    <div class="container membership-faq">
      <div class="section-heading"><div class="eyebrow">Good to know</div><h2 id="questions-heading">Membership questions.</h2></div>
      <details open><summary>Will any of my existing tools become paid features?</summary><p>No. All existing CE-Deploy 16.3.7 functionality stays in Free, including the deployment scheduler, recurring jobs, templates, and template chains. The new Automation feature is the addition included with Pro and Partner Plus.</p></details>
      <details><summary>Does xAPI Forge require a Pro membership?</summary><p>No. xAPI Forge is an existing tool and remains included in Free. It does not require a paid membership.</p></details>
      <details><summary>Where can I subscribe or start a trial?</summary><p>Visit <a href="https://buymeacoffee.com/voipnorm/membership">Buy Me a Coffee</a> for Pro and Partner Plus memberships. Each paid tier offers a 30-day trial that starts only when you explicitly choose to begin it in the app.</p></details>
      <details><summary>Can I try Partner Plus after trying Pro?</summary><p>Yes. Partner Plus has its own one-time, 30-day trial, including for people who have already tried or subscribed to Pro. Starting it does not reset your Pro trial dates.</p></details>
      <details><summary>How does Partner Plus customer access work?</summary><p>Partner Plus lets you select customer organizations available to your Webex partner or external administrator identity and use the applicable CE-Deploy cloud tools in that customer’s context. Each computer can select up to 30 customers in addition to 30 ordinary connections. Customer selections are local to each computer.</p><p>One membership owner manages up to four computer activations, including employee computers. Each operator uses their own Webex identity and permissions. Membership does not grant additional Webex permissions.</p></details>
      <details><summary>Does Partner Plus include FedRAMP customer access?</summary><p>The initial delegated customer capability is for commercial Webex. FedRAMP partner support is planned for later. Existing direct FedRAMP organization support remains part of Free.</p></details>
    </div>
  </section>
</BaseLayout>

<style>
  .membership-hero { padding-bottom: 40px; }
  .plans-section { padding-top: 40px; }
  .plan { display: flex; flex-direction: column; min-width: 0; }
  .plan-status { align-self: flex-start; border: 1px solid var(--line); border-radius: 100px; padding: 4px 12px; font-size: .875rem; color: var(--muted); }
  .available { color: var(--cyan); border-color: #376575; }
  .plan h2 { font-size: 1.75rem; letter-spacing: -.035em; margin: 20px 0 4px; }
  .plan-summary { margin: 0; min-height: 3.2em; }
  .plan .price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; margin: 24px 0 10px; }
  .price strong { color: var(--text); font-size: 3.5rem; letter-spacing: -.055em; line-height: 1.1; }
  .pro-plan { border-color: #4c7b95; background: linear-gradient(145deg,rgba(98,217,236,.08),rgba(113,137,255,.035)); }
  .plan-action { margin: auto 0 0; padding-top: 28px; }
  .plan-action .button { width: 100%; }
  .plans-note { font-size: .9375rem; color: var(--muted); }
  .plans-note { margin: 24px 0 0; }
  .comparison-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: 16px; }
  table { width: 100%; border-collapse: collapse; min-width: 700px; text-align: left; }
  caption { text-align: left; padding: 18px 22px; color: var(--muted); font-size: .9375rem; }
  th, td { padding: 18px 22px; border-top: 1px solid var(--line); }
  thead th { background: var(--surface); color: var(--cyan); white-space: nowrap; }
  tbody th { width: 48%; font-weight: 500; }
  td { color: var(--muted); font-size: .9375rem; }
  .membership-faq { max-width: 860px; }
  details { border-bottom: 1px solid var(--line); padding: 22px 0; }
  summary { cursor: pointer; font-weight: 650; font-size: 1.0625rem; }
  details p { color: var(--muted); max-width: 740px; }
  summary:focus-visible, .comparison-scroll:focus-visible { outline: 2px solid var(--cyan); outline-offset: 4px; }
  @media (max-width: 960px) { .plans { grid-template-columns: 1fr; } .plan-summary { min-height: auto; } }
</style>
